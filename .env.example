# Local development only — copy this to `.env` and set your backend URL.
# The app calls this backend relay, which holds the Gemini API keys.
# For a production Vercel deploy, set VITE_API_BASE to your Vercel URL
# (e.g. https://quizard.vercel.app). Leave empty to use a same-origin
# /api/gemini path (works when running via `vercel dev`).
VITE_API_BASE=

# ── Wizard voice (reviewer read-aloud) ──
# The reviewer reads documents with the Fish Audio "powerful wizard" voice.
# Run `FISH_API_KEY=xxxx node scripts/gen-wizard-voice.mjs` once — it designs
# the voice and writes these two values to .env automatically.
# In production, set the same two vars in Netlify → Environment variables.
# Without them the reviewer falls back to the on-device deep synthesis voice.
FISH_API_KEY=
FISH_VOICE_ID=
